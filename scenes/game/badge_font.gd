class_name BadgeFont
extends RefCounted

# Tiny embedded font (DejaVu Sans Bold, lowercase Greek only) so alpha/beta/etc.
# render on every platform without depending on system fonts.
const GREEK_B64 := ""

static var _greek : FontFile = null

static func greek_font() -> FontFile:
	if _greek == null:
		var f := FontFile.new()
		f.data = Marshalls.base64_to_raw(GREEK_B64)
		_greek = f
	return _greek

# Bold font for badge text: ThemeDB fallback for roman numerals, with the
# embedded Greek font as a fallback for alpha/beta/etc.
static func make_font() -> FontVariation:
	var base := FontVariation.new()
	base.base_font = ThemeDB.fallback_font
	base.fallbacks = [greek_font()]
	base.variation_embolden = 0.9
	return base
